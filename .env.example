# Copy this file to `.env` and fill in your Shopify Storefront API credentials.
# In Expo, only variables prefixed with EXPO_PUBLIC_ are exposed to the app.
# Restart the dev server after changing these (expo start -c to clear the cache).

# Your store domain, without protocol or trailing slash.
EXPO_PUBLIC_SHOPIFY_DOMAIN=your-store.myshopify.com

# Storefront API access token (public, safe to ship in a client app).
# Shopify admin → Settings → Apps and sales channels → Develop apps →
#   (your app) → API credentials → Storefront API access token.
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your-storefront-access-token

# Storefront API version (optional). Defaults to 2025-01 if omitted.
EXPO_PUBLIC_SHOPIFY_API_VERSION=2025-01
